      ],
      "id": "forward-to-ledger"
    },
    {
      "parameters": {
        "content": "## Part 3B - Drivers press buttons\nOne Telegram bot = one trigger. Button clicks -> assignment (state kept in 'Jobs' sheet). Typed commands -> forwarded to Part 4.",
        "height": 170,
        "width": 520
      },
      "name": "Note 3B",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        0,
