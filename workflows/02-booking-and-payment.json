      "webhookId": "hgt-create-booking-demo"
    },
    {
      "parameters": {
        "language": "python",
        "mode": "runOnceForAllItems",
        "pythonCode": "def py(x):\n    return x.to_py() if hasattr(x, \"to_py\") else x\n\nimport random, string\nfrom datetime import datetime, date\n\ndata = py(_input.first().json)\nb = data.get(\"body\") or {}\n\n# Prices live HERE (server side). We never trust a price sent by the AI.\nCATALOG = {\n    \"classic\": {\"name\": \"Hidden Gems Classic City Tour\", \"price\": 39,  \"per_person\": True,  \"max_people\": 12},\n    \"sunset\":  {\"name\": \"Sunset Viewpoints Tour\",        \"price\": 49,  \"per_person\": True,  \"max_people\": 12},\n    \"private\": {\"name\": \"Private Guided Tour (up to 6 people)\", \"price\": 220, \"per_person\": False, \"max_people\": 6},\n}\n\ntour = CATALOG.get(b.get(\"tour_id\"))\nif tour is None:\n    raise ValueError(f\"Unknown tour_id: {b.get('tour_id')}\")\n\ntry:\n    people = int(b.get(\"people\") or 1)\nexcept (TypeError, ValueError):\n    raise ValueError(f\"people must be a number, got: {b.get('people')}\")\nif not 1 <= people <= tour[\"max_people\"]:\n    raise ValueError(f\"people must be between 1 and {tour['max_people']} for this tour\")\n\ntry:\n    tour_date = datetime.strptime(str(b.get(\"date\")), \"%Y-%m-%d\").date()\nexcept ValueError:\n    raise ValueError(f\"date must be YYYY-MM-DD, got: {b.get('date')}\")\nif tour_date < date.today():\n    raise ValueError(\"date is in the past\")\n\nif not str(b.get(\"customer_name\") or \"\").strip():\n    raise ValueError(\"customer_name is required\")\n\namount_eur = tour[\"price\"] * people if tour[\"per_person\"] else tour[\"price\"]\nref = \"HG-\" + \"\".join(random.choices(string.ascii_uppercase + string.digits, k=6))\n\nreturn [{\"json\": {\n    \"booking_ref\": ref,\n    \"tour_id\": b[\"tour_id\"], \"tour_name\": tour[\"name\"], \"people\": people,\n    \"date\": str(b[\"date\"]), \"time\": b.get(\"time\"), \"customer_name\": str(b[\"customer_name\"]).strip(),\n    \"amount_eur\": amount_eur, \"amount_cents\": round(amount_eur * 100),\n}}]"
      },
      "name": "Validate and Price",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        200
      ],
      "id": "validate-and-price"
    },
