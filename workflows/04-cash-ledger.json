    {
      "parameters": {
        "language": "python",
        "mode": "runOnceForAllItems",
        "pythonCode": "def py(x):\n    return x.to_py() if hasattr(x, \"to_py\") else x\n\nimport re\n\nb = py(_input.first().json).get(\"body\") or {}\ntext = (b.get(\"text\") or \"\").strip()\nbase = {\"chat_id\": b.get(\"chat_id\"), \"driver\": b.get(\"driver\"), \"text\": text}\nUSAGE = \"Commands:\\n/cash REF AMOUNT\\n/card REF AMOUNT\\n/handover AMOUNT\\n/balance\"\n\nm = re.match(r\"^/(cash|card|handover|balance)(?:@\\w+)?\\s*(.*)$\", text, re.I)\nif not m:\n    return [{\"json\": {**base, \"valid\": False, \"error\": USAGE}}]\n\ncommand = m.group(1).lower()\nparts = m.group(2).split()\nif command == \"balance\":\n    return [{\"json\": {**base, \"valid\": True, \"command\": command}}]\n\nref = \"\" if command == \"handover\" else (parts[0].upper() if parts else \"\")\nraw_amount = parts[0] if command == \"handover\" else (parts[1] if len(parts) > 1 else \"\")\ntry:\n    amount = float(raw_amount.replace(\",\", \".\"))\nexcept ValueError:\n    amount = 0\nif amount <= 0 or (command != \"handover\" and not ref):\n    usage = \"/handover AMOUNT\" if command == \"handover\" else f\"/{command} REF AMOUNT\"\n    return [{\"json\": {**base, \"valid\": False, \"error\": f\"Please use: {usage}\"}}]\n\nreturn [{\"json\": {**base, \"valid\": True, \"command\": command, \"ref\": ref, \"amount\": amount}}]"
      },
