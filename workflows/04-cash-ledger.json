    {
      "parameters": {
        "language": "python",
        "mode": "runOnceForAllItems",
        "pythonCode": "def py(x):\n    return x.to_py() if hasattr(x, \"to_py\") else x\n\np = py(_(\"Parse Command\").first().json)\nrows = [py(i.json) for i in _input.all()]\nmine = [r for r in rows if r.get(\"Driver\") == p[\"driver\"]]\n\ndef total(method):\n    t = 0.0\n    for r in mine:\n        if str(r.get(\"Method\", \"\")).lower() == method:\n            try:\n                t += float(str(r.get(\"Amount\", 0)).replace(\",\", \".\"))\n            except ValueError:\n                pass\n    return t\n\ncash, card, handed = total(\"cash\"), total(\"card\"), total(\"handover\")\nbalance = cash - handed\nheads = {\n    \"cash\": f\"✅ Cash €{p.get('amount')} saved for {p.get('ref')}.\\n\",\n    \"card\": f\"✅ Card €{p.get('amount')} saved for {p.get('ref')}.\\n\",\n    \"handover\": f\"✅ Handover €{p.get('amount')} saved.\\n\",\n}\ntext = (heads.get(p.get(\"command\"), \"\") +\n        f\"💶 Cash you are holding: €{balance:.2f}\\n\"\n        f\"(cash €{cash:.2f} − handed over €{handed:.2f}, card on site €{card:.2f})\")\nreturn [{\"json\": {\"chat_id\": p[\"chat_id\"], \"text\": text}}]"
      },
